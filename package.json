{
  "name": "dragon-survival-datapack-viewer",
  "displayName": "龙之生存数据包可视化",
  "description": "在侧边栏可视化 Dragon Survival（龙之生存）数据包：物种、阶段、能力、惩罚、弹射物数据，并支持基础编辑。",
  "version": "0.1.7",
  "publisher": "dragon-survival-datapack-viewer",
  "license": "MIT",
  "author": {
    "name": "Tangwenjun910"
  },
  "homepage": "https://github.com/Tangwenjun910/dragon-survival-datapack-viewer",
  "bugs": {
    "url": "https://github.com/Tangwenjun910/dragon-survival-datapack-viewer/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tangwenjun910/dragon-survival-datapack-viewer.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onView:dragonSurvivalDatapack.view",
    "onLanguage:json",
    "onCommand:dragonSurvivalDatapack.open",
    "onCommand:dragonSurvivalDatapack.refresh",
    "onCommand:dragonSurvivalDatapack.selectDatapack"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dragonSurvivalDatapack",
          "title": "龙之生存数据包",
          "icon": "media/dragon.svg"
        }
      ]
    },
    "views": {
      "dragonSurvivalDatapack": [
        {
          "id": "dragonSurvivalDatapack.view",
          "name": "龙之生存数据包可视化",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "dragonSurvivalDatapack.open",
        "title": "打开龙之生存数据包可视化",
        "icon": "$(eye)"
      },
      {
        "command": "dragonSurvivalDatapack.refresh",
        "title": "刷新龙之生存数据包",
        "icon": "$(refresh)"
      },
      {
        "command": "dragonSurvivalDatapack.selectDatapack",
        "title": "选择龙之生存数据包目录",
        "icon": "$(folder-opened)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dragonSurvivalDatapack.refresh",
          "when": "view == dragonSurvivalDatapack.view",
          "group": "navigation@1"
        },
        {
          "command": "dragonSurvivalDatapack.selectDatapack",
          "when": "view == dragonSurvivalDatapack.view",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "龙之生存数据包可视化",
      "properties": {
        "dragonSurvivalDatapack.openJsonOnDetail": {
          "type": "boolean",
          "default": true,
          "description": "打开任意详细编辑界面时，同步打开对应的原始 JSON 文件。"
        },
        "dragonSurvivalDatapack.showLocalizedNames": {
          "type": "boolean",
          "default": true,
          "description": "龙种、阶段、技能等显示本地化名称，ID 以小字显示。"
        },
        "dragonSurvivalDatapack.showRawFieldKeys": {
          "type": "boolean",
          "default": true,
          "description": "编辑字段附近显示对应的原始 JSON 键名。"
        },
        "dragonSurvivalDatapack.rememberScrollPosition": {
          "type": "boolean",
          "default": true,
          "description": "从详情返回后保持之前的滚动位置。"
        },
        "dragonSurvivalDatapack.showResourcePreviews": {
          "type": "boolean",
          "default": true,
          "description": "在编辑界面中显示引用的图片资源预览。"
        },
        "dragonSurvivalDatapack.showReferences": {
          "type": "boolean",
          "default": true,
          "description": "显示技能、弹射物等数据是否被标签或其他数据引用。"
        },
        "dragonSurvivalDatapack.customEffectTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "自定义效果类型列表。添加后这些 effect_type 值会被视为合法，并出现在补全候选中。例如：[\"example:custom_effect\"]"
        },
        "dragonSurvivalDatapack.customEffects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "自定义 effect_type 值，例如 example:time"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "该自定义效果允许的字段名列表"
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "该自定义效果的必填字段名列表"
              }
            },
            "required": [
              "type"
            ]
          },
          "default": [],
          "description": "自定义效果定义，支持字段白名单和必填字段。例如：[{\"type\":\"example:time\",\"fields\":[\"field_a\",\"field_b\",\"field_c\"]}]"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.5"
  }
}
